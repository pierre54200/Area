# ===== Secrets =====
# Real environment files must never be committed
.env
.env.*
!.env.example

# Keys, certificates and Android signing keystores
*.pem
*.key
*.p12
*.keystore
*.jks
google-services.json

# Gitleaks reports may contain redacted findings
gitleaks-report*.json

# ===== Python / Django (server) =====
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
staticfiles/
media/
celerybeat-schedule*
db.sqlite3

# ===== Node (web, mobile, shared) =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# Web build output
dist/
build/
.vite/

# ===== React Native / Expo (mobile) =====
.expo/
web-build/
expo-env.d.ts
*.apk
*.aab

# Native folders generated by Expo prebuild
/mobile/android/
/mobile/ios/

# Android
.gradle/
local.properties
*.iml
captures/
.externalNativeBuild/
.cxx/

# Metro bundler
.metro-health-check*

# ===== Docker =====
# Local overrides with personal settings
docker-compose.override.yml

# ===== Obsidian (docs/notes) =====
# Personal workspace state, specific to each member
docs/notes/.obsidian/workspace*.json
docs/notes/.obsidian/cache
docs/notes/.trash/

# ===== Editors and OS =====
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ===== Logs =====
*.log
logs/